{
  "name": "slack-rss-exporter",
  "version": "1.0.0",
  "description": "Export RSS feed configurations from all Slack channels",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target node",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": ["slack", "rss", "export"],
  "author": "Akihisa Koyama",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@slack/web-api": "^7.0.0",
    "dotenv": "^16.0.0"
  }
}