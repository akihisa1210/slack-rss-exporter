# Slack Bot Token (xoxb-...)
SLACK_BOT_TOKEN=

# Optional: Output directory for exported files (default: ./output)
OUTPUT_DIR=./output

# Optional: Export format (json, csv, or opml, default: json)
EXPORT_FORMAT=json

# Optional: Rate limiting configuration
# Initial delay between requests in milliseconds (default: 1000)
SLACK_REQUEST_DELAY=1000

# Maximum delay when rate limited in milliseconds (default: 60000)
SLACK_MAX_REQUEST_DELAY=60000

# Number of retries for rate limited requests (default: 3)
SLACK_RATE_LIMIT_RETRIES=3